{
  "name": "cv-as-code",
  "version": "1.0.0",
  "private": true,
  "description": "My CV as code: one YAML source, rendered to HTML and PDF in French and English, tested like a product.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsx src/build.ts && tsx src/pdf.ts",
    "serve": "tsx src/serve.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:data": "playwright test --project=data",
    "test:e2e": "playwright test --project=e2e --project=a11y --project=responsive --project=dist",
    "test:pdf": "playwright test --project=pdf",
    "test:visual": "sh scripts/visual.sh",
    "test:visual:update": "sh scripts/visual.sh --update-snapshots",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "unpdf": "1.8.1"
  },
  "dependencies": {
    "@fontsource/lato": "5.3.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
